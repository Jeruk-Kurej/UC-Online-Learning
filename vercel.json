{
    "version": 2,
    "regions": ["hnd1"],
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
  "api/**/*.php": {
    "runtime": "vercel-php@0.8.0"
  }
},
    "routes": [
        { "src": "/build/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "dest": "/public/build/$1" },
        { "src": "/images/(.*)", "headers": { "cache-control": "public, max-age=86400, stale-while-revalidate=604800" }, "dest": "/public/images/$1" },
        { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
        { "src": "/robots.txt", "dest": "/public/robots.txt" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_URL": "https://yourproductionurl.com",
        "VIEW_COMPILED_PATH": "/tmp",
        "CACHE_DRIVER": "array",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "cookie",
        "FILESYSTEM_DISK": "cloudinary"
    }
}